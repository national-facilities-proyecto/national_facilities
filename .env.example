POSTGRES_DB=national_facilities
POSTGRES_USER=nf_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=changeme-genera-una-clave-segura
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

CORS_ALLOWED_ORIGINS=http://localhost:5173

# URL pública que utilizará el navegador para consumir la API.
VITE_API_URL=http://localhost:8000/api

# Creación explícita del administrador: exportar NF_ADMIN_PASSWORD al ejecutar
# bootstrap_admin; no se carga ningún usuario ficticio.
# Google Cloud: definir GS_BUCKET_NAME y Application Default Credentials
# en el entorno de despliegue. El bucket debe ser privado.
# GS_BUCKET_NAME=nombre-del-bucket-privado
